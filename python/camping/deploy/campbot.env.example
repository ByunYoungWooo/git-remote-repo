# campbot 운영 환경변수 — 이 파일은 예시일 뿐. 실동작 = .env (권한 600, git 제외)
# 복제: cp deploy/campbot.env.example .env && vi .env && chmod 600 .env

# --- Telegram 알림 (FR-016/017 — NFR-06: 이 파일 전용, 코드/로그에 ❌) ---
CAMPBOT_TG_TOKEN=
CAMPBOT_TG_CHAT_ID=

# --- KNPS 자격증명 (channels/ui.py load_env_credentials — 미설정 시 로그인 = C-1 HITL 사람 직접) ---
CAMPBOT_KNPS_ID=
CAMPBOT_KNPS_PW=

# --- 데이터 루트 (db·lock·session 위치. 기본값 ./data — 서비스에서는 절대경로 권장) ---
# CAMPBOT_HOME=/home/wooba/source/python/camping/data
